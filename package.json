{
  "name": "@mdaemon/sanitize-html",
  "version": "2.18.1",
  "description": "sanitize-html with a ready-to-use browser build (UMD and ES modules) and TypeScript types, kept on CommonJS htmlparser2 10.x. Tracks upstream sanitize-html releases.",
  "main": "index.js",
  "types": "index.d.ts",
  "browser": "dist/sanitize-html.umd.js",
  "module": "dist/sanitize-html.es.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "dist/"
  ],
  "scripts": {
    "test": "npx eslint ./index.js && mocha test/test.js",
    "build": "vite build",
    "build:dev": "vite build --config vite.config.dev.js",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpemdaemon/sanitize-html.git"
  },
  "keywords": [
    "html",
    "parser",
    "sanitizer",
    "sanitize",
    "xss",
    "umd",
    "browser"
  ],
  "author": "Apostrophe Technologies, Inc.",
  "license": "MIT",
  "dependencies": {
    "escape-string-regexp": "^4.0.0",
    "htmlparser2": "^10.1.0",
    "is-plain-object": "^5.1.0",
    "launder": "^1.7.2",
    "parse-srcset": "^1.0.2",
    "postcss": "^8.5.27"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "eslint": "^7.3.1",
    "eslint-config-apostrophe": "^3.4.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "mocha": "^11.8.0",
    "sinon": "^22.1.0",
    "vite": "^7.1.5"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7",
    "diff": "^9.0.0"
  }
}
